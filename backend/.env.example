# Data source: duckdb (recommended), parquet, live, or file
DATA_SOURCE=duckdb
DUCKDB_PATH=/home/amirae/kalshi.duckdb
# Optional table overrides (defaults match export schema):
# DUCKDB_MARKETS_TABLE=kalshi_markets
# DUCKDB_CANDLES_TABLE=kalshi_candlesticks
# DUCKDB_EVENTS_TABLE=forexfactory_events
# DUCKDB_NEWS_TABLE=finnhub_news

# Parquet fallbacks (when DATA_SOURCE=parquet)
KALSHI_PARQUET=/home/amirae/files/kalshi_markets.parquet
FF_PARQUET=/home/amirae/files/forexfactory_events.parquet
KALSHI_CANDLESTICKS_PARQUET=/home/amirae/files/kalshi_candlesticks.parquet
FINNHUB_NEWS_PARQUET=/home/amirae/files/finnhub_news.parquet

# Optional candlestick fetch for top chart markets when parquet lacks history
KALSHI_FETCH_CHARTS=1
KALSHI_LIVE=0
KALSHI_HISTORY_DAYS=120
KALSHI_CACHE_TTL=300
# 0 = all markets from parquet (all ~183 series); set 48 to cap
KALSHI_MAX_MARKETS=0
KALSHI_CHART_MARKETS=16
KALSHI_SERIES_PER_SHELF=80
FOREXFACTORY_CSV_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.csv

# Outbound alerts & morning digest (optional — without SMTP, alerts go to backend/data/alert_outbox.jsonl)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MacroWire <alerts@macrowire.local>
SMTP_TLS=1
ALERT_CHECK_INTERVAL_SEC=300
DIGEST_HOUR_UTC=12
